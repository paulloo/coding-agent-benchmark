# Platform database (control plane). Never expose this to a coding agent.
DATABASE_URL="postgresql://cab:cab_local_dev@127.0.0.1:5433/cab_benchmark"

# Isolated database used by the DogWalk benchmark project (execution plane).
DOGWALK_DATABASE_URL="postgresql://cab_agent:cab_agent_local@127.0.0.1:5433/cab_dogwalk"

# Root directory for per-agent git worktrees.
CAB_WORKSPACE_ROOT="./workspace"

# Artifact root for logs, diffs and evaluation output.
CAB_ARTIFACT_ROOT="./artifacts"

# Path to the independent DogWalk git repository.
CAB_DOGWALK_REPO="./benchmarks/dogwalk"

# Commit or tag that a run starts from when the task does not pin its own.
CAB_DEFAULT_BASE_REF="snapshot/base"

# Execution isolation. "container" is the only mode that satisfies the
# security model; "host" is a local development fallback and is recorded
# in the run configuration as isolation=none.
CAB_EXECUTION_ISOLATION="host"
