{
  "name": "coding-agent-benchmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm db:generate && pnpm --filter @cab/web dev",
    "build": "pnpm db:generate && pnpm --filter @cab/web build",
    "start": "pnpm --filter @cab/web start",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "bootstrap": "tsx scripts/setup.ts",
    "reset": "tsx scripts/reset.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "typecheck": "pnpm db:generate && tsc --noEmit -p tsconfig.json && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node --env-file=.env tests/smoke/api-smoke.mjs"
  },
  "dependencies": {
    "@cab/adapters": "workspace:*",
    "@cab/core": "workspace:*",
    "@cab/db": "workspace:*",
    "@cab/evaluator": "workspace:*",
    "@cab/prompts": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^18.0.10",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
